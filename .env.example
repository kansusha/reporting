# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Jira Cloud credentials are NOT env vars — each user adds their own Jira
# site URL, account email, and API token from Settings → API keys (see
# server/plugins/register-secrets.ts and server/lib/jira.ts).
